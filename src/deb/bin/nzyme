#!/bin/sh

set -e

# Re-execute as the nzyme user so that `sudo nzyme --migrate-database` does not leave root-owned files behind.
if [ "$(id -u)" -eq 0 ] && getent passwd nzyme > /dev/null 2>&1; then
  exec runuser -u nzyme -- "$0" "$@"
fi

if [ -f "/etc/default/nzyme" ]; then
  . "/etc/default/nzyme"
fi

# Default to running the main application if no specific command is provided.
COMMAND="main"
ARGS=""

# Parse arguments to detect commands and store non-command flags in ARGS.
for arg in "$@"; do
  case $arg in
    --migrate-database)
      COMMAND="migrate-database"
      ;;
    --bootstrap-test)
      COMMAND="bootstrap-test"
      ;;
    *)
      ARGS="$ARGS $arg"
      ;;
  esac
done

# Execute the appropriate command with all arguments passed through.
case $COMMAND in
  migrate-database)
    ${JAVA:=/usr/share/nzyme/jvm/bin/java} $NZYME_JAVA_OPTS -jar -Dlog4j.configurationFile=file:///etc/nzyme/log4j2-production-foreground.xml -Djava.util.logging.manager=org.apache.logging.log4j.jul.LogManager /usr/share/nzyme/nzyme.jar -c /etc/nzyme/nzyme.conf --migrate-database $ARGS
    ;;
  bootstrap-test)
    ${JAVA:=/usr/share/nzyme/jvm/bin/java} $NZYME_JAVA_OPTS -jar -Dlog4j.configurationFile=file:///etc/nzyme/log4j2-production-foreground.xml -Djava.util.logging.manager=org.apache.logging.log4j.jul.LogManager /usr/share/nzyme/nzyme.jar -c /etc/nzyme/nzyme.conf --bootstrap-test $ARGS
    ;;
  main)
    ${JAVA:=/usr/share/nzyme/jvm/bin/java} $NZYME_JAVA_OPTS -jar -Dlog4j.configurationFile=file:///etc/nzyme/log4j2-production.xml -Djava.util.logging.manager=org.apache.logging.log4j.jul.LogManager /usr/share/nzyme/nzyme.jar -c /etc/nzyme/nzyme.conf $ARGS
    ;;
esac
