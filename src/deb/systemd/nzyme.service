[Unit]
Description=Nzyme
Documentation=https://github.com/nzymeorg/nzyme
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
Restart=on-failure
RestartSec=10
User=nzyme
Group=nzyme
WorkingDirectory=/usr/share/nzyme
LimitNOFILE=64000

ExecStart=/usr/local/bin/nzyme

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# No ProtectSystem or ProtectHome: the data, crypto and plugin directories can be configured to be anywhere.
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

# When a JVM receives a SIGTERM signal it exits with 143.
SuccessExitStatus=143

# Make sure stderr/stdout is captured in the systemd journal.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
