#!/bin/sh

set -e

TAP_USER="nzyme-tap"
TAP_GROUP="nzyme-tap"
CONFIG_FILE="/etc/nzyme/nzyme-tap.conf"

configured_panic_log() {
  if [ ! -f "$CONFIG_FILE" ]; then
    return 0
  fi

  sed -n "s/^[ \t]*panic_log_file_path[ \t]*=[ \t]*[\"']\([^\"']*\)[\"'].*$/\1/p" "$CONFIG_FILE" | head -n 1
}

case "$1" in
  configure)
    if ! getent group "$TAP_GROUP" > /dev/null; then
      addgroup --system "$TAP_GROUP"
    fi

    if ! getent passwd "$TAP_USER" > /dev/null; then
      adduser --system --ingroup "$TAP_GROUP" --home /nonexistent --no-create-home \
        --shell /usr/sbin/nologin --gecos "Nzyme tap" "$TAP_USER"
    fi

    # BlueZ only accepts D-Bus calls from root and the bluetooth group.
    if getent group bluetooth > /dev/null; then
      adduser "$TAP_USER" bluetooth > /dev/null
    fi

    if [ -f "$CONFIG_FILE" ]; then
      chown "root:$TAP_GROUP" "$CONFIG_FILE"
      chmod 640 "$CONFIG_FILE"
    fi

    # Outside of its own log directory, the tap can only append to a panic log that already exists and belongs to it.
    panic_log=$(configured_panic_log)
    case "$panic_log" in
      /var/log/nzyme-tap/*)
        ;;
      /*)
        if [ -d "$(dirname "$panic_log")" ] && [ ! -L "$panic_log" ]; then
          touch "$panic_log"
          chown -h "$TAP_USER:$TAP_GROUP" "$panic_log"
        fi
        ;;
    esac

    if command -v udevadm > /dev/null 2>&1; then
      udevadm control --reload-rules > /dev/null 2>&1 || true
      udevadm trigger --subsystem-match=usb --subsystem-match=tty > /dev/null 2>&1 || true
    fi

    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload > /dev/null 2>&1 || true
    fi
    ;;
esac

exit 0
